* Control Statements 
.control
run
print allv > plot_data_v.txt
print alli > plot_data_i.txt
plot v(sys_transfer_req)
plot v(sys_write_req)
plot v(pclk)
plot v(presetn)
plot v(apb_ready_in)
plot v(apb_addr_out0)
plot v(apb_write_out)
plot v(apb_enable_out)
plot v(apb_sel_out)
plot v(sys_trans_done)
plot v(sys_rdata_out0)
plot v(apb_wdata_out0)
.endc
.end
